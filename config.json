{
  "llm": {
    "provider": "openai",
    "base_url": "https://api.deepseek.com/v1/chat/completions",
    "api_key_env": "ANTHROPIC_API_KEY",
    "model": "deepseek-chat",
    "temperature": 0.0,
    "max_tokens": 8000,
    "timeout": 120
  },
  "claude": {
    "model": "",
    "permission_mode": "acceptEdits",
    "allowed_tools": [],
    "disallowed_tools": [],
    "completion_idle": 5.0
  },
  "codex": {
    "binary": "codex",
    "model": "",
    "sandbox": "workspace-write",
    "extra_args": []
  },
  "approval": {
    "mode": "auto",
    "default_allow": true,
    "timeout": 120
  },
  "session": {
    "dir": "~/.tasker/sessions",
    "workspace_dir": "~/.tasker/workspace"
  },
  "dispatch": {
    "strategy": "codex-first-review",
    "complex_executor": "codex",
    "implementation_executor": "claude",
    "verification_executor": "codex",
    "claude_model": "DeepSeek-v4-pro",
    "codex_model": "ChatGPT-5.6"
  },
  "goal_loop": {
    "max_iterations": 1,
    "evaluator": "codex"
  },
  "max_parallel": 2,
  "timeout_per_task": 900
}
